# Landmap MCP Server — environment variables
# Copy this file to `.env` (loaded automatically from the repo root), or set
# these in claude_desktop_config.json. Both are OPTIONAL — the defaults are
# repo-relative, so a fresh git clone works with no configuration.

# Directory holding the Thai admin-boundary shapefiles (province subfolders).
# Default: <repo_root>/shapefiles  (auto-detected relative to server.py)
# LANDMAP_SHAPEFILE_DIR=C:\path\to\landmap\shapefiles

# Where fetched sessions + generated GIS output are written.
# Default: <repo_root>/output  (auto-detected relative to server.py)
# LANDMAP_OUTPUT_DIR=C:\path\to\landmap\output
